      "cwd": "${workspaceFolder}",
      "args": [
        "train",
        "--config",
        "infra/adapter/rtdetrv2_pytorch/experiments/rtdetrv2_r18vd_120e_coco_instance_seg_rle.yaml",
        "--output-dir",
        "${workspaceFolder}/out"
