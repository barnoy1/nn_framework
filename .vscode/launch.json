{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "current file",
      "type": "debugpy",
      "request": "launch",
      "subProcess": true,
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true  
    },
    {
      "name": "nn_framework: attach docker debugpy",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/workspace"
        }
      ],
      "justMyCode": true
    },
