{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "nn_framework: cli train",
      "type": "debugpy",
      "request": "launch",
      "subProcess": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/cli.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "train",
        "--config",
        "experiment/rtdetrv2_r18vd_120e_coco_instance_seg_rle.yaml",
        "--output-dir",
        "${workspaceFolder}/out"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "nn_framework: cli train 1 channel",
      "type": "debugpy",
      "request": "launch",
      "subProcess": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/cli.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "train",
        "--config",
        "experiment/rtdetrv2_r18vd_120e_coco_instance_seg_rle_1ch.yaml",
        "--output-dir",
        "${workspaceFolder}/out"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "nn_framework: cli eval",
      "type": "debugpy",
      "request": "launch",
      "subProcess": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/cli.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "eval",
        "--config",
        "experiment/rtdetrv2_r18vd_120e_coco_instance_seg_rle_1ch.yaml",
        "--output-dir",
        "${workspaceFolder}/out",
        "--checkpoint",
        "${workspaceFolder}/weights/rtdetrv2_r18vd_120e_coco_rerun_48.1.pth",
        "--device",
        "cuda"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "nn_framework: cli inference",
      "type": "debugpy",
      "request": "launch",
      "subProcess": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/cli.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "inference",
        "--config",
        "experiment/rtdetrv2_r18vd_120e_coco_instance_seg_rle.yaml",
        "--checkpoint",
        "${workspaceFolder}/weights/rtdetrv2_r18vd_120e_coco_rerun_48.1.pth",
        "--input-dir",
        "${workspaceFolder}/input_data",
        "--output-dir",
        "${workspaceFolder}/out",
        "--device",
        "cuda",
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "nn_framework: cli inference onnx",
      "type": "debugpy",
      "request": "launch",
      "subProcess": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/cli.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "inference-onnx",
        "--config",
        "experiment/rtdetrv2_r18vd_120e_coco_instance_seg_rle.yaml",
        "--model-profile",
        "r18",
        "--onnx-model",
        "${workspaceFolder}/raw_models/RT-DETR/rtdetrv2_pytorch/exported_models/model.onnx",
        "--input-dir",
        "${workspaceFolder}/input_data",
        "--output-dir",
        "${workspaceFolder}/out",
        "--device",
        "cuda"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "nn_framework: cli export onnx",
      "type": "debugpy",
      "request": "launch",
      "subProcess": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/cli.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "export-onnx",
        "--config",
        "experiment/rtdetrv2_r18vd_120e_coco_instance_seg_rle.yaml",
        "--checkpoint",
        "${workspaceFolder}/weights/rtdetrv2_r18vd_120e_coco_rerun_48.1.pth",
        "--onnx-model",
        "${workspaceFolder}/raw_models/RT-DETR/rtdetrv2_pytorch/exported_models/model.onnx"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "nn_framework: cli export coco rle",
      "type": "debugpy",
      "request": "launch",
      "subProcess": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/cli.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "export-coco-rle",
        "--config",
        "experiment/rtdetrv2_r18vd_120e_coco_instance_seg_rle.yaml",
        "--dataset_root",
        "${env:HOME}/Desktop/repo/datasets/drone-dataset-(uav)-DatasetNinja",
        "--output_dir",
        "${env:HOME}/Desktop/repo/datasets/drone-dataset-(uav)-DatasetNinja"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "nn_framework: launch mlflow (shared root mlruns)",
      "type": "debugpy",
      "request": "launch",
      "subProcess": false,
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/infra/tools/mlflow_server/launch_mlflow.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "${workspaceFolder}/out/mlruns",
        "--host",
        "127.0.0.1",
        "--port",
        "5000"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
