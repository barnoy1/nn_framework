# RF-DETR single-run profile
MODEL_IMAGE=rf-detr-model:local
MODEL_BACKEND=rf_detr
MODEL_SERVICE_URL=http://model:8080
MODEL_TIMEOUT_SECONDS=120
ENABLE_DEBUGPY=0
DEBUGPY_HOST=0.0.0.0
DEBUGPY_PORT=5678
DEBUGPY_WAIT_FOR_CLIENT=1
XAUTHORITY=${HOME}/.Xauthority

# Unified in-container launch flavor mapping (inputs like NN_EXPERIMENT_CONFIG/NN_CHECKPOINT/NN_INPUT_DIR remain user-provided)
NN_MODEL_SOURCE_ROOT=/model/raw_models/rf-detr
