# RF-DETR single-run profile
MODEL_IMAGE=rf-detr-model:local
MODEL_BACKEND=rf_detr
MODEL_SERVICE_URL=http://model:8080
MODEL_TIMEOUT_SECONDS=120
RUN_MODE=train
RUN_ACTION=train
RUN_CONFIG=experiment/rfdetr_small_coco_instance_seg_rle.yaml
ENABLE_DEBUGPY=0
DEBUGPY_HOST=0.0.0.0
DEBUGPY_PORT=5678
DEBUGPY_WAIT_FOR_CLIENT=1
XAUTHORITY=${HOME}/.Xauthority
