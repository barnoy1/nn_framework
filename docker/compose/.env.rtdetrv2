# RT-DETRv2 single-run profile
MODEL_IMAGE=rtdetrv2-model:local
MODEL_BACKEND=rtdetrv2
MODEL_SERVICE_URL=http://model:8080
MODEL_TIMEOUT_SECONDS=120
MLFLOW_PORT=5000
XAUTHORITY=${HOME}/.Xauthority
SHM_SIZE=16g
# Unified in-container launch flavor mapping (inputs like NN_EXPERIMENT_CONFIG/NN_CHECKPOINT/NN_INPUT_DIR remain user-provided)
NN_MODEL_SOURCE_ROOT=/model/raw_models/RT-DETR/rtdetrv2_pytorch
