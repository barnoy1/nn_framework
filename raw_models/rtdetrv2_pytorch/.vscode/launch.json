      "cwd": "${workspaceFolder}/../..",
      "args": [
        "inference",
        "--model-profile",
        "r18",
        "--checkpoint",
        "${workspaceFolder}/../../weights/rtdetrv2_r18vd_120e_coco_rerun_48.1.pth",
        "--input-dir",
        "${workspaceFolder}/docker/input_data",
        "--output-dir",
        "${workspaceFolder}/../../out",
        "--device",
        "cuda",
        "--batch-size",
        "1",
        "--num-workers",
        "2"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "nn_framework: cli inference onnx",
